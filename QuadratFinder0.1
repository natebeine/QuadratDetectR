if (!dir.exists(out_folder)) dir.create(out_folder, recursive = TRUE)

squares_df <- dplyr::filter(shapes_df, .data$type == "square")
if (nrow(squares_df) == 0) {
  message("No square shapes detected; no clipping will be performed.")
} else {
  # For each scan (TLS and MLS) clip to union of all detected hull polygons (now squares)
  scans <- list(TLS = CHT_17_TLS, MLS = CHT_17_MLS)
  for (scan_name in names(scans)) {
    las_in <- scans[[scan_name]]
    clipped_list <- list()
    for (j in seq_len(nrow(squares_df))) {
      hull_xy <- do.call(rbind, squares_df$hull_xy[[j]])
      clipped_part <- clip_las_by_hull(las_in, hull_xy)
      if (!is.null(clipped_part) && !is.empty(clipped_part)) clipped_list[[length(clipped_list) + 1]] <- clipped_part
    }
    if (length(clipped_list) == 0) {
      message("No points clipped for scan ", scan_name)
      next
    }
    merged_clipped <- do.call(rbind, clipped_list)
    out_path <- file.path(out_folder, paste0("CHT_17_", scan_name, "_quadrats_hull.laz"))
    writeLAS(merged_clipped, out_path)
    message("Wrote clipped quadrat points for ", scan_name, " to: ", out_path)
  }
}

