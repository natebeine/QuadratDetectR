# --- Oriented square fit + helpers ---------------------------------------

# Fit an oriented bounding box (PCA) and return center, size, and angle
# Modified to allow any square size (no hard size_range check)
square_fit_ls <- function(xy, min_pts = 1, aspect_tol = 0.25) {
  # xy: two-column matrix/data.frame of X, Y coordinates
  if (nrow(xy) < min_pts) return(NULL)
  mu <- colMeans(xy)
  pc <- prcomp(xy, center = TRUE, scale. = FALSE)
  rot <- pc$rotation
  coords_rot <- sweep(as.matrix(xy), 2, mu) %*% rot
  bbox_rot <- apply(coords_rot, 2, range)
  width <- bbox_rot[2,1] - bbox_rot[1,1]
  height <- bbox_rot[2,2] - bbox_rot[1,2]
  size <- mean(c(width, height))
  # aspect tolerance: width and height must be similar (<= aspect_tol * size)
  if (abs(width - height) > aspect_tol * size) return(NULL)
  center_rot <- c((bbox_rot[1,1] + bbox_rot[2,1]) / 2, (bbox_rot[1,2] + bbox_rot[2,2]) / 2)
  center_orig <- as.vector(mu + rot %*% center_rot)
  angle <- atan2(rot[2,1], rot[1,1]) # radians
  list(center = center_orig, size = size, angle = angle, width = width, height = height)
}

# Return 4 corners (matrix with columns X, Y) of rotated square given center, size, angle
rotated_square_corners <- function(center, size, angle) {
  half <- size / 2
  local <- matrix(c(-half, -half,
                    half, -half,
                    half,  half,
                    -half,  half), ncol = 2, byrow = TRUE)
  R <- matrix(c(cos(angle), -sin(angle), sin(angle), cos(angle)), ncol = 2)
  corners <- t( t(local %*% t(R)) + center )
  colnames(corners) <- c("X","Y")
  corners
}

# Clip LAS by rotated square (returns LAS or NULL)
clip_las_by_rotated_square <- function(las_obj, center, size, angle) {
  coords <- as.matrix(las_obj@data[, c("X","Y")])
  Rneg <- matrix(c(cos(angle),  sin(angle),
                   -sin(angle), cos(angle)), ncol = 2) # rotate by -angle
  local <- sweep(coords, 2, center) %*% Rneg
  half <- size / 2
  idx <- which(abs(local[,1]) <= half & abs(local[,2]) <= half)
  if (length(idx) == 0) return(NULL)
  LAS(las_obj@data[idx, , drop = FALSE], header = las_obj@header)
}

# NEW: Clip LAS by convex-hull polygon (hull_xy: Nx2 matrix of vertices)
clip_las_by_hull <- function(las_obj, hull_xy) {
  if (is.null(hull_xy) || nrow(hull_xy) < 3) return(NULL)
  coords <- as.matrix(las_obj@data[, c("X","Y")])
  pip <- sp::point.in.polygon(point.x = coords[,1], point.y = coords[,2],
                              pol.x = hull_xy[,1], pol.y = hull_xy[,2])
  idx <- which(pip != 0) # 1 inside, 2 boundary, 3 vertex
  if (length(idx) == 0) return(NULL)
  LAS(las_obj@data[idx, , drop = FALSE], header = las_obj@header)
}

