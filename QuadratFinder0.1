  for (scan_name in names(scans)) {
    las_in <- scans[[scan_name]]
    clipped_list <- list()
    for (j in seq_len(nrow(shapes_df))) {
      if (tilt_clip) {
        # plane-perpendicular clipping:  use stored center3, R, sq_center_rot
        center3 <- unlist(shapes_df$center3[[j]])
        R <- shapes_df$R[[j]]
        sq_center_rot <- unlist(shapes_df$sq_center_rot[[j]])
        size <- shapes_df$size[j]
        clipped_part <- clip_las_by_square_on_plane(las_in, center3, R, sq_center_rot, size, buffer_clip)
      } else {
        # axis-aligned XY bounding rectangle of the fitted square corners
        corners_xy <- as.matrix(shapes_df$corners_xy[[j]])
        if (is.null(corners_xy) || nrow(corners_xy) < 3) next
        xmin <- min(corners_xy[,1], na.rm = TRUE)
        xmax <- max(corners_xy[,1], na.rm = TRUE)
        ymin <- min(corners_xy[,2], na.rm = TRUE)
        ymax <- max(corners_xy[,2], na.rm = TRUE)
        clipped_part <- clip_rectangle(las_in, xmin, xmax, ymin, ymax)
      }
      if (! is.null(clipped_part) && ! is.empty(clipped_part)) clipped_list[[length(clipped_list) + 1]] <- clipped_part
    }
    if (length(clipped_list) == 0) {
      message("No points clipped for scan ", scan_name)
      next
    }
    merged_clipped <- do.call(rbind, clipped_list)
    out_suffix <- if (tilt_clip) "plane_clipped" else "axis_clip"
    out_path <- file.path(out_folder, paste0("CHT_17_", scan_name, "_quadrats_", out_suffix, ". laz"))
    writeLAS(merged_clipped, out_path)
    message("Wrote clipped quadrat points for ", scan_name, " to: ", out_path)
  }
}

