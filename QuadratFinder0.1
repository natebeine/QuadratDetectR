CHT_17_MLS <- readLAS("Y:/ABOR_TLS/2025/Scans/ABOR_grads/Understory_Processing/Good alignment/MLS/ABOR_Kaibab_CHT_17_25_MLS.laz")
out_folder <- "Q:/ABOR_TLS/2025/Scans/Understory Aligned/Good alignment/Quadrats"
dir.create(out_folder, recursive = TRUE, showWarnings = FALSE)

# ---- Read LAS ---------------------------------------------------------------
CHT_17_TLS <- readLAS(tls_path)
CHT_17_MLS <- readLAS(mls_path)
if (is.null(CHT_17_MLS) || is.empty(CHT_17_MLS)) stop("CHT_17_MLS is empty or failed to load")
if (is.null(CHT_17_TLS) || is.empty(CHT_17_TLS)) stop("CHT_17_TLS is empty or failed to load")

# ---- Mode:  choose tilt or axis-aligned clipping -----------------------------
tilt_clip <- TRUE   # TRUE = clip perpendicular to quadrat plane; FALSE = axis-aligned bbox

# ---- Tuning (adjust for your data) -----------------------------------------
intensity_cut <- 30000
conn_res <- 0.1
conn_min_pts <- 5
min_pts_component <- 10
aspect_tol <- 0.40
error_pct_max <- 40
buffer_clip <- 0.02
size_percentile <- 0.95  # NEW: use 95th percentile for size estimation (adjust 0.90-0.98)

# ---- Helper functions ------------------------------------------------------
square_fit_ls <- function(xy, min_pts = 1, aspect_tol = 0.25, size_pct = 0.95) {
  if (nrow(xy) < min_pts) return(NULL)
  mu <- colMeans(xy)
  pc <- prcomp(xy, center = TRUE, scale.  = FALSE)
  rot <- pc$rotation
  coords_rot <- sweep(as.matrix(xy), 2, mu) %*% rot
  bbox_rot <- apply(coords_rot, 2, range)
  width <- bbox_rot[2,1] - bbox_rot[1,1]
  height <- bbox_rot[2,2] - bbox_rot[1,2]
  
  # CHANGED: Use percentile-based size estimation instead of mean
  # This accounts for outliers and gives a better fit to the bulk of points
  abs_x <- abs(coords_rot[,1])
  abs_y <- abs(coords_rot[,2])
  width_pct <- 2 * quantile(abs_x, probs = size_pct, na.rm = TRUE)
  height_pct <- 2 * quantile(abs_y, probs = size_pct, na.rm = TRUE)
  
  # Use the larger of bbox or percentile estimates
  width_final <- max(width, width_pct)
  height_final <- max(height, height_pct)
  size <- max(width_final, height_final)  # CHANGED: use max instead of mean
  
  if (size <= 0) return(NULL)
  if (abs(width_final - height_final) > aspect_tol * size) return(NULL)
  
  center_rot <- c((bbox_rot[1,1] + bbox_rot[2,1]) / 2, (bbox_rot[1,2] + bbox_rot[2,2]) / 2)
  center_orig <- as.vector(mu + rot %*% center_rot)
  angle <- atan2(rot[2,1], rot[1,1])
  list(center = center_orig, size = size, angle = angle, width = width_final, height = height_final)
}

rotated_square_corners <- function(center, size, angle) {
  half <- size / 2
  local <- matrix(c(-half, -half,
                    half, -half,
                    half,  half,
                    -half,  half), ncol = 2, byrow = TRUE)
  R <- matrix(c(cos(angle), -sin(angle), sin(angle), cos(angle)), ncol = 2)
  corners <- t( t(local %*% t(R)) + center )
  colnames(corners) <- c("X","Y")
  corners
}

# Rotate points so the best-fit plane for xyz is horizontal.
rotate_points_to_plane <- function(xyz) {
  mat <- as.matrix(xyz)
  mu3 <- colMeans(mat)
  Xc <- sweep(mat, 2, mu3)
  sv <- svd(Xc, nu = 3, nv = 3)
  basis <- sv$v
  R <- t(basis)
  coords_rot <- t(R %*% t(Xc))
  list(R = R, invR = t(R), center3 = mu3, xyz_rot = coords_rot,
       xy = coords_rot[,1:2, drop = FALSE], z = coords_rot[,3])
}

# Clip LAS by a square defined in rotated plane frame (keeps ALL points inside)
clip_las_by_square_on_plane <- function(las_obj, center3, R, sq_center_rot, size, buffer = 0) {
  coords <- as.matrix(las_obj@data[, c("X", "Y", "Z")])
  coords_centered <- sweep(coords, 2, center3)
  coords_rot <- t(R %*% t(coords_centered))
  local <- sweep(coords_rot[,1:2, drop = FALSE], 2, sq_center_rot)
  half <- size / 2 + buffer
  idx <- which(abs(local[,1]) <= half & abs(local[,2]) <= half)
  if (length(idx) == 0) return(NULL)
  LAS(las_obj@data[idx, , drop = FALSE], header = las_obj@header)
}

# Axis-aligned rectangle clip helper
clip_rectangle <- function(las_obj, xmin, xmax, ymin, ymax) {
  coords <- as.data.frame(las_obj@data[, c("X","Y")])
  idx <- which(coords$X >= xmin & coords$X <= xmax & coords$Y >= ymin & coords$Y <= ymax)
  if (length(idx) == 0) return(NULL)
  LAS(las_obj@data[idx, , drop = FALSE], header = las_obj@header)
}

# ---- Candidate detection on MLS (intensity filtering) ----------------------
if (! ("Intensity" %in% names(CHT_17_MLS@data))) stop("No 'Intensity' field found in MLS.  Aborting detection.")
message("Filtering MLS points with Intensity >", intensity_cut)
if ("filter_poi" %in% ls("package:lidR")) {
  CHT_17_MLS_filt <- filter_poi(CHT_17_MLS, Intensity > intensity_cut)
} else {
  idx_i <- which(! is.na(CHT_17_MLS@data$Intensity) & CHT_17_MLS@data$Intensity > intensity_cut)
  CHT_17_MLS_filt <- LAS(CHT_17_MLS@data[idx_i, , drop = FALSE], header = CHT_17_MLS@header)
}
if (is.empty(CHT_17_MLS_filt)) stop("No points left after Intensity filtering on MLS")
CHT_17_MLS_filt <- connected_components(CHT_17_MLS_filt, res = conn_res, min_pts = conn_min_pts, name = "Component")
df <- as.data.frame(CHT_17_MLS_filt@data)

# ---- Per-component processing:  plane fit -> rotate -> 2D square fit ----------
shapes <- list()
for (cid in unique(df$Component)) {
  component_points <- df[df$Component == cid, ]
  if (nrow(component_points) < min_pts_component) next
  
  comp_xyz <- as.matrix(component_points[, c("X","Y","Z")])
  # If tilt clipping is enabled, fit plane and rotate; otherwise we still rotate to help PCA (optional)
  rot_res <- rotate_points_to_plane(comp_xyz)
  rxy <- rot_res$xy
  
  # CHANGED: Pass size_percentile parameter
  sq <- square_fit_ls(rxy, min_pts = 6, aspect_tol = aspect_tol, size_pct = size_percentile)
  if (is.null(sq)) next
  
  # compute fit error in rotated frame
  angle <- sq$angle
  Rneg <- matrix(c(cos(angle),  sin(angle), -sin(angle), cos(angle)), ncol = 2)
  local_pts <- sweep(as.matrix(rxy), 2, sq$center) %*% Rneg
  half <- sq$size / 2
  raw_err <- mean(pmin(
    abs(local_pts[,1] - (-half)),
    abs(local_pts[,1] - ( half)),
    abs(local_pts[,2] - (-half)),
    abs(local_pts[,2] - ( half))
  )^2)
  raw_error_square <- sqrt(raw_err)
  error_pct <- (raw_error_square / sq$size) * 100
  votes <- sum(abs(local_pts[,1]) <= half & abs(local_pts[,2]) <= half)
  
  # CHANGED: Relax error check slightly since we're fitting larger boxes
  if (error_pct > error_pct_max * 1.2) next  # Allow 20% more error
  
  inside_idx <- which(abs(local_pts[,1]) <= half & abs(local_pts[,2]) <= half)
  z_value <- if (length(inside_idx) > 0) median(rot_res$z[inside_idx], na.rm = TRUE) else median(rot_res$z, na.rm = TRUE)
  
  # compute rotated 2D corners, then map them back to original 3D and extract XY for plotting/axis bbox
  corners_rot_xy <- rotated_square_corners(sq$center, sq$size, sq$angle)
  corners_rot_3d <- cbind(corners_rot_xy, z_value)
  invR <- rot_res$invR
  corners_orig3 <- t(invR %*% t(corners_rot_3d)) + matrix(rot_res$center3, nrow = nrow(corners_rot_3d), ncol = 3, byrow = TRUE)
  corners_orig_xy <- corners_orig3[, 1:2, drop = FALSE]
  
  shape <- tibble(
    type = "square",
    component = cid,
    center3 = list(rot_res$center3),    # needed for tilted clipping
    R = list(rot_res$R),                # rotation original -> rotated
    sq_center_rot = list(sq$center),    # square center in rotated frame
    size = sq$size,
    angle = sq$angle,
    z = z_value,
    raw_error = raw_error_square,
    error_pct = error_pct,
    votes = votes,
    corners_xy = list(corners_orig_xy)
  )
  shapes[[length(shapes) + 1]] <- shape
}

shapes_df <- if (length(shapes) == 0) {
  tibble(type = character(), component = integer(), center3 = list(), R = list(), sq_center_rot = list(),
         size = double(), angle = double(), z = double(), raw_error = double(), error_pct = double(),
