# detect_quadrats_axis_with_tilt_option.R
# Axis-aligned clipping script with optional plane-aligned (tilted) clipping.
# Set tilt_clip = TRUE to clip perpendicular to the fitted quadrat plane;
# set tilt_clip = FALSE to clip by axis-aligned XY bounding box of the fitted square. 
#
# Edit file paths and tuning at top, then run. 
#
library(lidR)
