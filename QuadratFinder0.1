# --- Fit squares only per component (allow any square size) ----------------

shapes <- list()

for (cid in unique(df$Component)) {
  component_points <- df[df$Component == cid, ]  # Get all points in the component
  pts <- component_points[, c("X", "Y")]         # Extract X and Y coordinates
  
  if (nrow(pts) < 10) next  # Skip very small components
  
  square <- square_fit_ls(pts)  # Fit an oriented square (any size)
  if (is.null(square)) next
  
  # Calculate fitting error for the square (in rotated frame)
  cx <- square$center[1]; cy <- square$center[2]; s <- square$size / 2
  angle <- square$angle
  Rneg <- matrix(c(cos(angle),  sin(angle),
                   -sin(angle), cos(angle)), ncol = 2)
  local_pts <- sweep(as.matrix(pts), 2, square$center) %*% Rneg
  res_square <- mean(pmin(
    abs(local_pts[,1] - (-s)),
    abs(local_pts[,1] - ( s)),
    abs(local_pts[,2] - (-s)),
    abs(local_pts[,2] - ( s))
  )^2)
  raw_error_square <- sqrt(res_square)
  error_square_pct <- (raw_error_square / square$size) * 100
  votes_square <- sum(abs(local_pts[,1]) <= s & abs(local_pts[,2]) <= s)
  
  # Compute representative Z using points near the square area (in rotated frame)
  all_coords <- as.matrix(component_points[, c("X","Y")])
  local_all <- sweep(all_coords, 2, square$center) %*% Rneg
  inside_idx <- which(abs(local_all[,1]) <= s & abs(local_all[,2]) <= s)
  square_z_points <- if (length(inside_idx) > 0) component_points$Z[inside_idx] else component_points$Z
  z_value <- mean(square_z_points)
  
  # NEW: compute convex hull of the component points and store polygon
  ch_idx <- chull(component_points$X, component_points$Y)
  hull_xy_raw <- as.matrix(component_points[c(ch_idx), c("X","Y")])
  # FORCED: replace hull with the fitted square polygon (4 corners) to ensure square clipping
  hull_xy <- rotated_square_corners(square$center, square$size, square$angle)
  # ensure polygon ring order is consistent (no duplicate closing point required for point.in.polygon)
  
  shape <- tibble(type = "square",
                  center_x = square$center[1],
                  center_y = square$center[2],
                  size = square$size,
                  angle = square$angle,
                  z = z_value,
                  raw_error = raw_error_square,
                  error_pct = error_square_pct,
                  votes = votes_square,
                  hull_xy = list(hull_xy))
  
  shapes[[length(shapes) + 1]] <- shape
}

