# QuadratDetectR.R
# Detect quadrat frames in intensity-filtered MLS, fit oriented squares, and clip TLS + MLS.
#
# Workflow:
#   1) Filter the MLS by intensity and find candidate frames (connected components).
#   2) Fit a min-area rotated rectangle to each candidate (in its best-fit plane if tilt_clip = TRUE).
#   3) Clip the TLS and MLS to the INSIDE of each fitted square, pulled inward by `clip_inset`
#      so the frame itself is excluded. Only points up to `clip_max_height` above each fitted
#      square are kept; height is measured perpendicular to the fitted plane, so tilted frames
#      get a tilted clip prism.
#   4) Write the clipped points to LAZ files and the fit parameters to a CSV.

library(lidR)
library(tidyverse)
library(rgl)

# ---- User paths (edit) -----------------------------------------------------
tls_path   <- "path to your TLS file"
mls_path   <- "path to your MLS file"
out_folder <- "path to your output folder"
site_id    <- tools::file_path_sans_ext(basename(tls_path))   # used to name output files
dir.create(out_folder, recursive = TRUE, showWarnings = FALSE)

# ---- Mode ------------------------------------------------------------------
tilt_clip  <- TRUE    # TRUE: fit/clip in the best-fit plane of each frame; FALSE: plain XY
axis_bbox  <- FALSE   # only used when tilt_clip = FALSE: TRUE = axis-aligned bbox of the square

# ---- Tuning ----------------------------------------------------------------
quadrat_size      <- NULL   # OUTER side length of the frame in metres (e.g. 0.5 or 1). NULL = fit it.
size_tol          <- 0.25   # accepted fractional deviation from quadrat_size (0.25 = +/-25%)
intensity_cut     <- 30000
conn_res          <- 0.1
conn_min_pts      <- 5
min_pts_component <- 30
aspect_tol        <- 0.20   # |w - h| <= aspect_tol * size
error_pct_max     <- 10     # mean distance of points to nearest edge, as % of size
mad_k             <- 3      # outlier cutoff (MADs of distance from component centre)
trim_prob         <- 0.01   # robust box: ignore the most extreme 1% on each side (0 = off)
angle_step_deg    <- 0.5
clip_inset        <- 0.04   # metres the clip is pulled INSIDE each square edge (adjustable;
#   set 0 to clip exactly on the square, negative to expand outward)
clip_max_height   <- 1.37   # m ABOVE the fitted square, measured perpendicular to its plane
clip_min_height   <- -Inf   # m below the fitted square (negative number, e.g. -0.1); -Inf = no limit

# ---- Helpers ---------------------------------------------------------------

# Subset a LAS by row index
subset_las <- function(las_obj, idx) {
  if (length(idx) == 0) return(NULL)
  LAS(las_obj@data[idx, , drop = FALSE], header = las_obj@header, check = FALSE)
}

# Rotate xyz into the best-fit plane frame (z_rot = distance from plane).
# rot = (xyz - center3) %*% V ; back: xyz = rot %*% t(V) + center3
plane_frame <- function(xyz, use_plane = TRUE) {
  xyz <- as.matrix(xyz)
  if (!use_plane) {
    return(list(V = diag(3), center3 = c(0, 0, 0), rot = xyz))
  }
  center3 <- colMeans(xyz)
  Xc <- sweep(xyz, 2, center3)
  V <- svd(Xc, nu = 0, nv = 3)$v
  if (det(V) < 0) V[, 3] <- -V[, 3]          # keep a proper rotation (no mirroring)
  if (V[3, 3] < 0) { V[, 3] <- -V[, 3]; V[, 2] <- -V[, 2] }   # plane normal points UP (+Z side);
  # flipping two columns keeps det > 0
  list(V = V, center3 = center3, rot = Xc %*% V)
}

# Min-area rotated rectangle. Returns centre (in input frame), angle (rad), w, h, size.
fit_square_minarea <- function(xy, angle_step_deg = 0.5, trim_prob = 0) {
  xy <- as.matrix(xy)
  angles <- seq(0, 90 - angle_step_deg, by = angle_step_deg) * pi / 180
  rng_fun <- if (trim_prob > 0) {
    function(v) quantile(v, c(trim_prob, 1 - trim_prob), names = FALSE)
  } else {
    function(v) range(v)
  }
  best <- NULL
  for (a in angles) {
    R <- matrix(c(cos(a), sin(a), -sin(a), cos(a)), 2)   # p = xy %*% R rotates by -a
    p <- xy %*% R
    r1 <- rng_fun(p[, 1]); r2 <- rng_fun(p[, 2])
    w <- diff(r1); h <- diff(r2)
    area <- w * h
    if (is.null(best) || area < best$area) {
      best <- list(area = area, angle = a, w = w, h = h,
                   center = as.vector(R %*% c(mean(r1), mean(r2))))
    }
  }
  best$size <- mean(c(best$w, best$h))
  best
}

# Corners of a rotated square (matrix X, Y), counter-clockwise
rotated_square_corners <- function(center, size, angle) {
  half <- size / 2
  local <- matrix(c(-half, -half,  half, -half,  half, half,  -half, half),
                  ncol = 2, byrow = TRUE)
  Rpos <- matrix(c(cos(angle), sin(angle), -sin(angle), cos(angle)), 2)  # rotate by +angle
  corners <- local %*% t(Rpos)
  corners <- sweep(corners, 2, center, "+")
  colnames(corners) <- c("X", "Y")
  corners
}

# Clip a LAS to the INSIDE of a rotated square defined in a plane frame (V, center3).
# inset > 0 shrinks the clip square by `inset` metres on every side.
# Height is measured along the plane normal from the fitted square (z_level in the plane frame):
# keeps points with  min_height <= (distance above plane) <= max_height.
clip_las_square <- function(las_obj, V, center3, sq_center, size, angle, z_level = 0,
                            inset = 0, max_height = Inf, min_height = -Inf) {
  half <- size / 2 - inset
  if (half <= 0) return(NULL)
  xyz <- as.matrix(las_obj@data[, c("X", "Y", "Z")])
  rot <- sweep(xyz, 2, center3) %*% V
  Rneg <- matrix(c(cos(angle), sin(angle), -sin(angle), cos(angle)), 2)  # rotate by -angle
  local <- sweep(rot[, 1:2, drop = FALSE], 2, sq_center) %*% Rneg
  h <- rot[, 3] - z_level                    # perpendicular height above the fitted square
  idx <- which(abs(local[, 1]) <= half & abs(local[, 2]) <= half &
                 h <= max_height & h >= min_height)
  subset_las(las_obj, idx)
}

# Axis-aligned rectangle clip
# (Only used when tilt_clip = FALSE, where the plane frame is the world frame, so
#  perpendicular height = vertical Z above z_level.)
clip_rectangle <- function(las_obj, xmin, xmax, ymin, ymax, z_level = 0,
                           max_height = Inf, min_height = -Inf) {
  if (xmax <= xmin || ymax <= ymin) return(NULL)
  d <- las_obj@data
  h <- d$Z - z_level
  subset_las(las_obj, which(d$X >= xmin & d$X <= xmax & d$Y >= ymin & d$Y <= ymax &
                              h <= max_height & h >= min_height))
}

# ---- Read data ---------------------------------------------------------------
TLS <- readLAS(tls_path)
MLS <- readLAS(mls_path)
if (is.null(MLS) || is.empty(MLS)) stop("MLS is empty or failed to load")
if (is.null(TLS) || is.empty(TLS)) stop("TLS is empty or failed to load")
if (!("Intensity" %in% names(MLS@data))) {
  stop("No 'Intensity' field in MLS. Available: ", paste(names(MLS@data), collapse = ", "))
}

# ---- Candidate detection (intensity filter + connected components) ---------
message("Filtering MLS points with Intensity > ", intensity_cut)
MLS_filt <- filter_poi(MLS, Intensity > intensity_cut)
if (is.empty(MLS_filt)) stop("No points left after intensity filtering")

MLS_filt <- connected_components(MLS_filt, res = conn_res, min_pts = conn_min_pts, name = "Component")
df <- as.data.frame(MLS_filt@data)
df <- df[!is.na(df$Component), ]

# ---- Per-component fit -------------------------------------------------------
shapes <- list()
for (cid in unique(df$Component)) {
  comp <- df[df$Component == cid, ]
  if (nrow(comp) < min_pts_component) next
  
  # Skip components obviously much larger than a quadrat
  if (!is.null(quadrat_size)) {
    ext <- max(diff(range(comp$X)), diff(range(comp$Y)))
    if (ext > quadrat_size * 3) next
  }
  
  fr <- plane_frame(comp[, c("X", "Y", "Z")], use_plane = tilt_clip)
  rxy <- fr$rot[, 1:2, drop = FALSE]
  
  # 1) Outlier trimming: distance from robust centre
  cen0 <- apply(rxy, 2, median)
  d <- sqrt(rowSums(sweep(rxy, 2, cen0)^2))
  keep <- d <= median(d) + mad_k * mad(d)
  if (!is.null(quadrat_size)) keep <- keep & d <= quadrat_size * 0.9   # half-diagonal ~0.71*size
  if (sum(keep) < min_pts_component) next
  rxy_k <- rxy[keep, , drop = FALSE]
  rz_k  <- fr$rot[keep, 3]
  
  # 2) Min-area rotated rectangle
  fit <- fit_square_minarea(rxy_k, angle_step_deg, trim_prob)
  size <- if (is.null(quadrat_size)) fit$size else quadrat_size
  
  # 3) Shape sanity checks
  if (size <= 0) next
  if (abs(fit$w - fit$h) > aspect_tol * size) next
  if (!is.null(quadrat_size) && abs(fit$size - quadrat_size) > size_tol * quadrat_size) next
  
  # 4) Fit error: mean distance to nearest edge, % of size
  Rneg <- matrix(c(cos(fit$angle), sin(fit$angle), -sin(fit$angle), cos(fit$angle)), 2)
  lp <- sweep(rxy_k, 2, fit$center) %*% Rneg
  half <- size / 2
  edge_d <- pmin(abs(abs(lp[, 1]) - half), abs(abs(lp[, 2]) - half))
  raw_error <- mean(edge_d)
  error_pct <- raw_error / size * 100
  if (error_pct > error_pct_max) next
  votes <- sum(abs(lp[, 1]) <= half & abs(lp[, 2]) <= half)
  
  # 5) Corners back in original XYZ
  z_level <- median(rz_k)
  c_rot <- rotated_square_corners(fit$center, size, fit$angle)
  c_orig <- cbind(c_rot, z_level) %*% t(fr$V)
  c_orig <- sweep(c_orig, 2, fr$center3, "+")
  colnames(c_orig) <- c("X", "Y", "Z")
  
  shapes[[length(shapes) + 1]] <- tibble(
    type = "square", component = cid,
    V = list(fr$V), center3 = list(fr$center3),
    sq_center = list(fit$center), z_level = z_level,
    size = size, fitted_size = fit$size, angle = fit$angle,
    width = fit$w, height = fit$h,
    raw_error = raw_error, error_pct = error_pct, votes = votes,
    corners = list(c_orig)
  )
}

shapes_df <- if (length(shapes) == 0) tibble() else bind_rows(shapes)
if (nrow(shapes_df) == 0) stop("No squares passed the filters. Loosen aspect_tol/error_pct_max or set quadrat_size.")

print(shapes_df %>% select(component, size, fitted_size, width, height, error_pct, votes))
write_csv(shapes_df %>% select(component, size, fitted_size, width, height, angle, error_pct, votes),
          file.path(out_folder, paste0(site_id, "_quadrat_fits.csv")))

# ---- 2D check plot (blue = fitted square, red = actual clip boundary) --------
poly_df <- bind_rows(lapply(seq_len(nrow(shapes_df)), function(i) {
  m <- as.data.frame(shapes_df$corners[[i]][, 1:2])
  m$group <- i
  m
}))
clip_df <- bind_rows(lapply(seq_len(nrow(shapes_df)), function(i) {
  if (shapes_df$size[i] / 2 - clip_inset <= 0) return(NULL)
  m <- as.data.frame(rotated_square_corners(shapes_df$sq_center[[i]],
                                            shapes_df$size[i] - 2 * clip_inset,
                                            shapes_df$angle[i]))
  m$group <- i
  m
}))
lab_df <- poly_df %>% group_by(group) %>%
  summarise(X = mean(X), Y = mean(Y), .groups = "drop") %>%
  mutate(label = paste0(round(shapes_df$fitted_size[group], 2), " m"))

p <- ggplot(df, aes(X, Y)) +
  geom_point(size = 0.4, alpha = 0.5) +
  geom_polygon(data = poly_df, aes(X, Y, group = group), color = "blue", fill = NA, linewidth = 0.8) +
  geom_text(data = lab_df, aes(X, Y, label = label), inherit.aes = FALSE, vjust = -1.5, size = 3) +
  coord_equal() + theme_minimal() +
  ggtitle("Fitted quadrat squares (min-area rectangle, outliers trimmed)")
print(p)
# Zoom into a single frame to inspect the fit, e.g.:
# print(p + coord_equal(xlim = range(poly_df$X[poly_df$group == 1]) + c(-0.5, 0.5),
#                       ylim = range(poly_df$Y[poly_df$group == 1]) + c(-0.5, 0.5)))

# ---- 3D check plot -----------------------------------------------------------
open3d()
points3d(df$X, df$Y, df$Z, col = "gray", size = 3, alpha = 0.5)
for (i in seq_len(nrow(shapes_df))) {
  cr <- shapes_df$corners[[i]]
  cr <- rbind(cr, cr[1, , drop = FALSE])
  lines3d(cr[, 1], cr[, 2], cr[, 3], col = "blue", lwd = 3)   # true 3D corners, follows tilt
}
axes3d()
title3d("3D fitted quadrats", xlab = "X", ylab = "Y", zlab = "Z")

# ---- Clip TLS and MLS (inside each square, inset by clip_inset) --------------
scans <- list(TLS = TLS, MLS = MLS)
for (scan_name in names(scans)) {
  las_in <- scans[[scan_name]]
  clipped <- list()
  for (j in seq_len(nrow(shapes_df))) {
    if (!tilt_clip && axis_bbox) {
      cr <- shapes_df$corners[[j]]
      part <- clip_rectangle(las_in,
                             min(cr[, 1]) + clip_inset, max(cr[, 1]) - clip_inset,
                             min(cr[, 2]) + clip_inset, max(cr[, 2]) - clip_inset,
                             z_level = shapes_df$z_level[j],
                             max_height = clip_max_height, min_height = clip_min_height)
    } else {
      part <- clip_las_square(las_in,
                              V = shapes_df$V[[j]],
                              center3 = shapes_df$center3[[j]],
                              sq_center = shapes_df$sq_center[[j]],
                              size = shapes_df$size[j],
                              angle = shapes_df$angle[j],
                              z_level = shapes_df$z_level[j],
                              inset = clip_inset,
                              max_height = clip_max_height,
                              min_height = clip_min_height)
    }
    if (!is.null(part) && !is.empty(part)) clipped[[length(clipped) + 1]] <- part
  }
  if (length(clipped) == 0) {
    message("No points clipped for scan ", scan_name)
    next
  }
  merged <- do.call(rbind, clipped)
  suffix <- if (tilt_clip) "plane_clipped" else if (axis_bbox) "axis_bbox_clipped" else "xy_clipped"
  out_path <- file.path(out_folder, paste0(site_id, "_", scan_name, "_quadrats_", suffix, ".laz"))
  writeLAS(merged, out_path)
  message("Wrote ", scan_name, " quadrat points to: ", out_path)
}

# ---- End ---------------------------------------------------------------------
