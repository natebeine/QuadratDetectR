# app.R
# Shiny app: quadrat frame detection + clipping ONLY (MLS frames -> clip MLS and optional TLS)
#
# Workflow:
#   1) Upload MLS (needs an Intensity field) and, optionally, an aligned TLS scan.
#   2) "1. Detect quadrats": only the bright MLS points (Intensity > cutoff) are read from the
#      file and used to find the frames (connected components -> min-area rotated rectangle fit
#      in each frame's best-fit plane). Quadrats are located in the MLS only. The full scans are
#      never held in memory.
#   3) Adjust the INWARD CLIP BUFFER (clip_inset). The red clip boundary in the plot updates
#      live (use the zoom selector to inspect one frame).
#   4) "2. Clip & export": for each quadrat, the raw, unprocessed points (all attributes) in a
#      small window around the frame are read from the MLS (and TLS) file and clipped inside the
#      frame (pulled inward by the buffer, height measured perpendicular to the fitted plane).
#      One combined LAZ per scan is written, named <original file name>_<MLS|TLS>_quadrats.laz.
#      Optionally, each quadrat is also written as its own LAZ. Everything is delivered as a
#      zip download. You can change the buffer and re-run step 2 without re-running detection.
#
# Progress messages are shown live to the user (progress bar, bottom-right) and printed to the
# console. The processing log box is only shown when an error occurs.

suppressPackageStartupMessages({
  library(shiny)
  library(dplyr)
  library(tibble)
})

check_packages <- function() {
  needed <- c("lidR")
  missing <- needed[!vapply(needed, requireNamespace, quietly = TRUE, FUN.VALUE = logical(1))]
  if (length(missing)) stop("Missing required package(s): ", paste(missing, collapse = ", "), call. = FALSE)
  invisible(TRUE)
}

# Large uploads (TLS clouds are big). Adjust to what your host allows.
options(shiny.maxRequestSize = 1500 * 1024^2)

# =============================================================================
# Geometry helpers
# =============================================================================

subset_las <- function(las_obj, idx) {
  if (length(idx) == 0) return(NULL)
  lidR::LAS(las_obj@data[idx, , drop = FALSE], header = las_obj@header, check = FALSE)
}

# Rotate xyz into the best-fit plane frame (z_rot = distance from plane).
plane_frame <- function(xyz, use_plane = TRUE) {
  xyz <- as.matrix(xyz)
  if (!use_plane) return(list(V = diag(3), center3 = c(0, 0, 0), rot = xyz))
  center3 <- colMeans(xyz)
  Xc <- sweep(xyz, 2, center3)
  V <- svd(Xc, nu = 0, nv = 3)$v
  if (det(V) < 0) V[, 3] <- -V[, 3]
  if (V[3, 3] < 0) { V[, 3] <- -V[, 3]; V[, 2] <- -V[, 2] }   # plane normal points up
  list(V = V, center3 = center3, rot = Xc %*% V)
}

# Min-area rotated rectangle
fit_square_minarea <- function(xy, angle_step_deg = 0.5, trim_prob = 0) {
  xy <- as.matrix(xy)
  angles <- seq(0, 90 - angle_step_deg, by = angle_step_deg) * pi / 180
  rng_fun <- if (trim_prob > 0) {
    function(v) quantile(v, c(trim_prob, 1 - trim_prob), names = FALSE)
  } else {
    function(v) range(v)
  }
  best <- NULL
  for (a in angles) {
    R <- matrix(c(cos(a), sin(a), -sin(a), cos(a)), 2)
    p <- xy %*% R
    r1 <- rng_fun(p[, 1]); r2 <- rng_fun(p[, 2])
    w <- diff(r1); h <- diff(r2)
    area <- w * h
    if (is.null(best) || area < best$area) {
      best <- list(area = area, angle = a, w = w, h = h,
                   center = as.vector(R %*% c(mean(r1), mean(r2))))
    }
  }
  best$size <- mean(c(best$w, best$h))
  best
}

# Corners of a rotated rectangle (matrix X, Y), counter-clockwise.
# sx = extent along the rotated x axis, sy = extent along the rotated y axis.
rotated_rect_corners <- function(center, sx, sy, angle) {
  hx <- sx / 2; hy <- sy / 2
  local <- matrix(c(-hx, -hy,  hx, -hy,  hx, hy,  -hx, hy), ncol = 2, byrow = TRUE)
  Rpos <- matrix(c(cos(angle), sin(angle), -sin(angle), cos(angle)), 2)
  corners <- local %*% t(Rpos)
  corners <- sweep(corners, 2, center, "+")
  colnames(corners) <- c("X", "Y")
  corners
}

# Clip a LAS to the INSIDE of a rotated rectangle defined in a plane frame.
# inset > 0 pulls the clip edge inward by `inset` metres on every side (negative = outward).
# Height is measured perpendicular to the fitted plane (upper limit = max_height, no lower limit).
# `corners` (3D corners in original XYZ) is used only for a cheap XY pre-filter.
# The returned LAS is a plain row subset of the input: no points are modified or thinned.
clip_las_rect <- function(las_obj, V, center3, sq_center, size_x, size_y, angle, z_level = 0,
                          inset = 0, max_height = Inf, min_height = -Inf, corners = NULL) {
  half_x <- size_x / 2 - inset
  half_y <- size_y / 2 - inset
  if (half_x <= 0 || half_y <= 0) return(NULL)
  d <- las_obj@data
  pre <- seq_len(nrow(d))
  if (!is.null(corners)) {
    mh <- if (is.finite(max_height)) abs(max_height) else 3
    mn <- if (is.finite(min_height)) abs(min_height) else 3
    mg <- 0.1 + 0.5 * max(mh, mn) + max(0, -inset)
    cx <- mean(corners[, 1]); cy <- mean(corners[, 2])
    ex <- max(abs(corners[, 1] - cx)) + mg
    ey <- max(abs(corners[, 2] - cy)) + mg
    pre <- which(abs(d$X - cx) <= ex & abs(d$Y - cy) <= ey)
    if (length(pre) == 0) return(NULL)
  }
  xyz <- cbind(d$X[pre], d$Y[pre], d$Z[pre])
  rot <- sweep(xyz, 2, center3) %*% V
  Rneg <- matrix(c(cos(angle), sin(angle), -sin(angle), cos(angle)), 2)
  local <- sweep(rot[, 1:2, drop = FALSE], 2, sq_center) %*% Rneg
  h <- rot[, 3] - z_level
  keep <- which(abs(local[, 1]) <= half_x & abs(local[, 2]) <= half_y &
                  h <= max_height & h >= min_height)
  subset_las(las_obj, pre[keep])
}

# ---- Quadrat detection (connected components + rectangle fit) ----
# `MLS` should contain only the bright (frame) points; the intensity filter is re-applied here
# so the function also works on a full cloud.
# quad_length / quad_width: known outer frame dimensions in metres (both NULL = fit a square).
detect_quadrat_squares <- function(MLS, intensity_cut = 30000, quad_length = NULL, quad_width = NULL,
                                   size_tol = 0.25,
                                   conn_res = 0.1, conn_min_pts = 5, min_pts_component = 30,
                                   aspect_tol = 0.20, error_pct_max = 10, mad_k = 3,
                                   trim_prob = 0.01, angle_step_deg = 0.5, tilt_clip = TRUE) {
  known <- !is.null(quad_length) && !is.null(quad_width)
  max_known <- if (known) max(quad_length, quad_width) else NA_real_
  
  MLS_filt <- lidR::filter_poi(MLS, Intensity > intensity_cut)
  if (lidR::is.empty(MLS_filt)) return(list(shapes = tibble::tibble(), pts = NULL))
  
  MLS_filt <- lidR::connected_components(MLS_filt, res = conn_res, min_pts = conn_min_pts, name = "Component")
  df <- as.data.frame(MLS_filt@data)
  df <- df[!is.na(df$Component), ]
  rm(MLS_filt)
  
  shapes <- list()
  for (cid in unique(df$Component)) {
    comp <- df[df$Component == cid, ]
    if (nrow(comp) < min_pts_component) next
    
    if (known) {
      ext <- max(diff(range(comp$X)), diff(range(comp$Y)))
      if (ext > max_known * 3) next
    }
    
    fr <- plane_frame(comp[, c("X", "Y", "Z")], use_plane = tilt_clip)
    rxy <- fr$rot[, 1:2, drop = FALSE]
    
    # 1) Outlier trimming
    cen0 <- apply(rxy, 2, median)
    d <- sqrt(rowSums(sweep(rxy, 2, cen0)^2))
    keep <- d <= median(d) + mad_k * mad(d)
    if (known) keep <- keep & d <= max_known * 0.9
    if (sum(keep) < min_pts_component) next
    rxy_k <- rxy[keep, , drop = FALSE]
    rz_k  <- fr$rot[keep, 3]
    
    # 2) Min-area rotated rectangle
    fit <- fit_square_minarea(rxy_k, angle_step_deg, trim_prob)
    
    # 3) Frame dimensions + shape sanity checks
    if (known) {
      # assign the known length/width to the fitted axes (whichever pairing matches best)
      if ((abs(fit$w - quad_length) + abs(fit$h - quad_width)) <=
          (abs(fit$w - quad_width) + abs(fit$h - quad_length))) {
        sx <- quad_length; sy <- quad_width
      } else {
        sx <- quad_width; sy <- quad_length
      }
      if (abs(fit$w - sx) > size_tol * sx || abs(fit$h - sy) > size_tol * sy) next
    } else {
      sx <- fit$size; sy <- fit$size
      if (abs(fit$w - fit$h) > aspect_tol * fit$size) next
    }
    size_ref <- mean(c(sx, sy))
    if (size_ref <= 0) next
    
    # 4) Fit error
    Rneg <- matrix(c(cos(fit$angle), sin(fit$angle), -sin(fit$angle), cos(fit$angle)), 2)
    lp <- sweep(rxy_k, 2, fit$center) %*% Rneg
    hx <- sx / 2; hy <- sy / 2
    edge_d <- pmin(abs(abs(lp[, 1]) - hx), abs(abs(lp[, 2]) - hy))
    raw_error <- mean(edge_d)
    error_pct <- raw_error / size_ref * 100
    if (error_pct > error_pct_max) next
    votes <- sum(abs(lp[, 1]) <= hx & abs(lp[, 2]) <= hy)
    
    # 5) Corners back in original XYZ
    z_level <- median(rz_k)
    c_rot <- rotated_rect_corners(fit$center, sx, sy, fit$angle)
    c_orig <- cbind(c_rot, z_level) %*% t(fr$V)
    c_orig <- sweep(c_orig, 2, fr$center3, "+")
    colnames(c_orig) <- c("X", "Y", "Z")
    
    shapes[[length(shapes) + 1]] <- tibble::tibble(
      type = "rectangle", component = cid,
      V = list(fr$V), center3 = list(fr$center3),
      sq_center = list(fit$center), z_level = z_level,
      size_x = sx, size_y = sy, fitted_x = fit$w, fitted_y = fit$h,
      angle = fit$angle,
      raw_error = raw_error, error_pct = error_pct, votes = votes,
      corners = list(c_orig)
    )
  }
  
  shapes_df <- if (length(shapes) == 0) tibble::tibble() else dplyr::bind_rows(shapes)
  list(shapes = shapes_df, pts = df[, c("X", "Y", "Z")])
}

