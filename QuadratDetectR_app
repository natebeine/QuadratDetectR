# =============================================================================
# SERVER
# =============================================================================

server <- function(input, output, session) {
  rv <- reactiveValues(
    MLS_path = NULL, TLS_path = NULL, shapes = NULL, pts = NULL,
    error_log = "", status = "", current_step = "Idle", progress = 0,
    laz_files = NULL, mls_name = "mls", tls_name = NULL
  )
  
  # keep slider and numeric box for the inward buffer in sync
  observeEvent(input$clip_inset_slider, {
    if (!isTRUE(all.equal(input$clip_inset_slider, input$clip_inset)))
      updateNumericInput(session, "clip_inset", value = input$clip_inset_slider)
  }, ignoreInit = TRUE)
  observeEvent(input$clip_inset, {
    req(is.finite(input$clip_inset))
    if (!isTRUE(all.equal(input$clip_inset_slider, input$clip_inset)))
      updateSliderInput(session, "clip_inset_slider", value = input$clip_inset)
  }, ignoreInit = TRUE)
  
  # ---- messaging helpers ----------------------------------------------------
  # Errors are the only thing written to the on-screen log.
  add_error <- function(msg) {
    message("ERROR: ", msg)
    rv$error_log <- paste(c(rv$error_log[nzchar(rv$error_log)], msg), collapse = "\n")
  }
  
  # Progress: printed to the console AND shown live to the user (progress bar, bottom-right).
  # Works inside withProgress(); outside of it only the console/status text are updated.
  set_progress <- function(step, p, msg = NULL) {
    p <- max(0, min(1, p))
    rv$current_step <- step
    rv$progress <- p
    txt <- if (is.null(msg)) step else msg
    rv$status <- txt
    message(sprintf("[%3d%%] %s - %s", round(p * 100), step, txt))
    try(shiny::setProgress(value = p, message = step, detail = txt), silent = TRUE)
  }
  
  # Informational note (console + live progress detail, not in the log box)
  note <- function(msg) {
    rv$status <- msg
    message(msg)
    try(shiny::setProgress(detail = msg), silent = TRUE)
  }
  
  output$current_step <- renderText(rv$current_step)
  output$progress_pct <- renderText(sprintf("%d%%", round(100 * rv$progress)))
  output$progress_ui <- renderUI({
    tags$div(
      style = "width:100%; background:#eee; border-radius:6px; height:20px;",
      tags$div(style = sprintf("width:%s; background:#2c7fb8; height:20px; border-radius:6px; transition: width 0.2s;",
                               paste0(round(100 * rv$progress), "%")))
    )
  })
  output$status_msg <- renderText(rv$status)
  
  output$error_ui <- renderUI({
    if (!nzchar(rv$error_log)) return(NULL)
    tagList(h4("Error Log"), verbatimTextOutput("log_output"))
  })
  output$log_output <- renderText(rv$error_log)
  
  inset_val <- reactive({
    v <- input$clip_inset
    if (is.null(v) || !is.finite(v)) 0 else v
  })
  
  # ---------------------------------------------------------------------------
  # Step 1: detection (reads only the bright MLS points)
  # ---------------------------------------------------------------------------
  observeEvent(input$run_detect, {
    req(input$mls_file)
    rv$error_log <- ""; rv$status <- ""
    rv$MLS_path <- NULL; rv$TLS_path <- NULL; rv$shapes <- NULL; rv$pts <- NULL; rv$laz_files <- NULL
    gc()
    
    rv$mls_name <- tools::file_path_sans_ext(input$mls_file$name)
    rv$tls_name <- if (!is.null(input$tls_file)) tools::file_path_sans_ext(input$tls_file$name) else NULL
    
    # known frame dimensions (blank = fit; one value = square)
    qL <- input$quad_length; qW <- input$quad_width
    qL <- if (is.null(qL) || is.na(qL)) NULL else qL
    qW <- if (is.null(qW) || is.na(qW)) NULL else qW
    if (is.null(qL) && !is.null(qW)) qL <- qW
    if (is.null(qW) && !is.null(qL)) qW <- qL
    
    res <- withProgress(message = "Detecting quadrats", value = 0, {
      tryCatch({
        check_packages()
        
        set_progress("Read MLS", 0.05, "Reading only the bright MLS points for frame detection...")
        MLS <- lidR::readLAS(input$mls_file$datapath, select = "xyzi",
                             filter = paste("-keep_intensity_above", input$intensity_cut))
        if (is.null(MLS) || lidR::is.empty(MLS) || !("Intensity" %in% names(MLS@data))) {
          stop("No MLS points above the intensity cutoff (or the file has no Intensity values). ",
               "Try a lower cutoff.")
        }
        note(sprintf("Bright MLS points used for detection: %s", format(nrow(MLS@data), big.mark = ",")))
        
        TLS_hdr <- NULL
        if (!is.null(input$tls_file)) {
          set_progress("Check TLS", 0.2, "Reading TLS header only...")
          TLS_hdr <- lidR::readLASheader(input$tls_file$datapath)
        }
        
        set_progress("Detect quadrats", 0.4,
                     paste0("Locating quadrat frames in the MLS (Intensity > ", input$intensity_cut, ")..."))
        if (!is.null(qL)) note(sprintf("Using known frame size: %.3f m x %.3f m", qL, qW))
        det <- detect_quadrat_squares(
          MLS, intensity_cut = input$intensity_cut, quad_length = qL, quad_width = qW,
          size_tol = input$size_tol, conn_res = input$conn_res, conn_min_pts = input$conn_min_pts,
          min_pts_component = input$min_pts_component, aspect_tol = input$aspect_tol,
          error_pct_max = input$error_pct_max, mad_k = input$mad_k, trim_prob = input$trim_prob,
          angle_step_deg = input$angle_step_deg, tilt_clip = isTRUE(input$tilt_clip)
        )
        rm(MLS); gc()
        
        shapes_df <- det$shapes
        if (nrow(shapes_df) == 0) {
          stop("No quadrat frames passed the filters. Try a different intensity cutoff, loosen the aspect / ",
               "error settings, or set a known frame length and width.")
        }
        shapes_df$quadrat_id <- paste0("Q", seq_len(nrow(shapes_df)))
        set_progress("Detect quadrats", 0.85, sprintf("Detected %d quadrat(s) in the MLS scan.", nrow(shapes_df)))
        
        if (!is.null(TLS_hdr)) {
          h <- TLS_hdr@PHB
          cx <- vapply(shapes_df$corners, function(m) mean(m[, 1]), numeric(1))
          cy <- vapply(shapes_df$corners, function(m) mean(m[, 2]), numeric(1))
          inside <- cx >= h[["Min X"]] & cx <= h[["Max X"]] & cy >= h[["Min Y"]] & cy <= h[["Max Y"]]
          if (!any(inside)) {
            stop("None of the MLS-detected quadrats fall inside the TLS extent. The TLS must be spatially ",
                 "aligned with the MLS (same coordinate system / registration).")
          }
          if (!all(inside)) {
            wmsg <- paste0("Warning: quadrat(s) outside TLS extent: ",
                           paste(shapes_df$quadrat_id[!inside], collapse = ", "))
            note(wmsg)
            showNotification(wmsg, type = "warning", duration = 10)
          }
        }
        
        pts <- det$pts
        if (nrow(pts) > 200000) pts <- pts[sample.int(nrow(pts), 200000), ]   # display only
        
        list(shapes = shapes_df, pts = pts)
      }, error = function(e) {
        add_error(conditionMessage(e))
        NULL
      })
    })
    
    if (is.null(res)) {
      rv$current_step <- "Failed"
      rv$status <- "Detection failed - see the error log."
      return()
    }
    rv$MLS_path <- input$mls_file$datapath
    rv$TLS_path <- if (!is.null(input$tls_file)) input$tls_file$datapath else NULL
    rv$shapes <- res$shapes; rv$pts <- res$pts
    updateSelectInput(session, "zoom_quad",
                      choices = c("All" = "All", stats::setNames(res$shapes$quadrat_id, res$shapes$quadrat_id)),
                      selected = "All")
    set_progress("Detection done", 1, "Detection complete. Adjust the inward buffer if needed, then click '2. Clip & export'.")
    gc()
  })
  
  # ---------------------------------------------------------------------------
  # Step 2: clip + export (reads one small window per quadrat from each file)
  # ---------------------------------------------------------------------------
  observeEvent(input$run_clip, {
    if (is.null(rv$shapes) || is.null(rv$MLS_path)) {
      showNotification("Run '1. Detect quadrats' first.", type = "error")
      return()
    }
    rv$error_log <- ""; rv$status <- ""
    shapes_df <- rv$shapes
    nq <- nrow(shapes_df)
    inset <- inset_val()
    max_h <- input$clip_max_height
    export_indiv <- isTRUE(input$export_individual)
    
    # output names: original file name + scan type (_MLS / _TLS) + "_quadrats"
    out_names <- list(MLS = paste0(rv$mls_name, "_MLS"))
    if (!is.null(rv$TLS_path)) out_names$TLS <- paste0(rv$tls_name, "_TLS")
    
    message(sprintf("---- Clipping: inward buffer = %.4f m, max height = %.2f m, individual files = %s ----",
                    inset, max_h, export_indiv))
    
    res <- withProgress(message = "Clipping quadrats", value = 0, {
      tryCatch({
        out_dir <- file.path(tempdir(), paste0("quadrats_", format(Sys.time(), "%Y%m%d_%H%M%S")))
        dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)
        
        scans <- list(MLS = rv$MLS_path)
        if (!is.null(rv$TLS_path)) scans$TLS <- rv$TLS_path
        
        laz_files <- character(0)
        nsc <- length(scans)
        for (si in seq_along(scans)) {
          scan_name <- names(scans)[si]
          scan_path <- scans[[si]]
          parts <- list()
          for (j in seq_len(nq)) {
            qid <- shapes_df$quadrat_id[j]
            set_progress(paste0(scan_name, " ", qid, " clip"),
                         ((si - 1) + (j - 1) / nq) / nsc * 0.9,
                         sprintf("Clipping %s (%d/%d)...", scan_name, j, nq))
            
            # read only the window around this quadrat (all attributes, raw points)
            cr <- shapes_df$corners[[j]]
            mg <- 0.1 + max_h + max(0, -inset)
            win <- lidR::readLAS(
              scan_path, select = "*",
              filter = sprintf("-keep_xy %.4f %.4f %.4f %.4f",
                               min(cr[, 1]) - mg, min(cr[, 2]) - mg,
                               max(cr[, 1]) + mg, max(cr[, 2]) + mg))
            part <- if (is.null(win) || lidR::is.empty(win)) NULL else clip_las_rect(
              win,
              V = shapes_df$V[[j]], center3 = shapes_df$center3[[j]],
              sq_center = shapes_df$sq_center[[j]],
              size_x = shapes_df$size_x[j], size_y = shapes_df$size_y[j],
              angle = shapes_df$angle[j], z_level = shapes_df$z_level[j],
              inset = inset, max_height = max_h, min_height = -Inf,
              corners = shapes_df$corners[[j]]
            )
            rm(win)
            
            if (is.null(part) || lidR::is.empty(part)) {
              note(sprintf("%s %s: no points inside the clip volume (buffer may be too large).", scan_name, qid))
              next
            }
            note(sprintf("%s %s: %s points.", scan_name, qid, format(nrow(part@data), big.mark = ",")))
            parts[[qid]] <- part
            
            # optional: one LAZ per quadrat
            if (export_indiv) {
              ipath <- file.path(out_dir, paste0(out_names[[scan_name]], "_", qid, ".laz"))
              lidR::writeLAS(part, ipath)
              laz_files <- c(laz_files, ipath)
              note(paste("Wrote", basename(ipath)))
            }
          }
          if (length(parts) == 0) {
            note(paste("No points clipped for scan", scan_name))
            next
          }
          
          set_progress(paste0("Write ", scan_name), (si / nsc) * 0.95,
                       paste("Writing combined", scan_name, "LAZ file..."))
          merged <- do.call(rbind, unname(parts))
          path <- file.path(out_dir, paste0(out_names[[scan_name]], "_quadrats.laz"))
          lidR::writeLAS(merged, path)
          laz_files <- c(laz_files, path)
          note(paste("Wrote", basename(path)))
          rm(merged, parts); gc()
        }
        laz_files
      }, error = function(e) {
        add_error(conditionMessage(e))
        NULL
      })
    })
    
    if (is.null(res) || length(res) == 0) {
      rv$current_step <- "Failed"
      rv$status <- "Clipping failed or produced no output."
      if (!nzchar(rv$error_log)) add_error("No points were clipped for any scan (the inward buffer may be too large).")
      return()
    }
    rv$laz_files <- res
    set_progress("Done", 1, "Clipping complete. Use the download button for the LAZ files.")
  })
  
  # ---------------------------------------------------------------------------
  # Outputs
  # ---------------------------------------------------------------------------
  fits_tbl <- reactive({
    req(rv$shapes)
    inset <- inset_val()
    rv$shapes %>%
      transmute(
        quadrat_id,
        length_m = round(pmax(size_x, size_y), 4),
        width_m = round(pmin(size_x, size_y), 4),
        fitted_length_m = round(pmax(fitted_x, fitted_y), 4),
        fitted_width_m = round(pmin(fitted_x, fitted_y), 4),
        angle_deg = round(angle * 180 / pi, 2),
        error_pct = round(error_pct, 2), votes,
        clip_length_m = round(pmax(pmax(size_x, size_y) - 2 * inset, 0), 4),
        clip_width_m = round(pmax(pmin(size_x, size_y) - 2 * inset, 0), 4)
      )
  })
  output$quadrat_fits_table <- renderTable(fits_tbl(), rownames = FALSE)
  
  output$quadrat_plot <- renderPlot({
    shapes_df <- rv$shapes
    pts <- rv$pts
    req(shapes_df, pts)
    inset <- inset_val()
    
    zoom <- input$zoom_quad
    xlim <- range(pts$X); ylim <- range(pts$Y)
    if (!is.null(zoom) && zoom != "All" && zoom %in% shapes_df$quadrat_id) {
      cr <- shapes_df$corners[[which(shapes_df$quadrat_id == zoom)]]
      xlim <- range(cr[, 1]) + c(-0.3, 0.3)
      ylim <- range(cr[, 2]) + c(-0.3, 0.3)
      pts <- pts[pts$X >= xlim[1] & pts$X <= xlim[2] & pts$Y >= ylim[1] & pts$Y <= ylim[2], ]
    }
    plot(pts$X, pts$Y, pch = 16, cex = 0.3, col = grDevices::adjustcolor("grey30", 0.5),
         asp = 1, xlim = xlim, ylim = ylim, xlab = "X", ylab = "Y",
         main = sprintf("Fitted frames (blue) and clip boundary (red, inward buffer = %.3f m)", inset))
    for (i in seq_len(nrow(shapes_df))) {
      p <- shapes_df$corners[[i]][, 1:2, drop = FALSE]
      p <- rbind(p, p[1, , drop = FALSE])
      lines(p[, 1], p[, 2], col = "blue", lwd = 2)
      text(mean(p[1:4, 1]), mean(p[1:4, 2]),
           sprintf("%s (%.2f x %.2f m)", shapes_df$quadrat_id[i],
                   max(shapes_df$size_x[i], shapes_df$size_y[i]),
                   min(shapes_df$size_x[i], shapes_df$size_y[i])),
           pos = 3, cex = 0.8)
      # clip boundary: frame pulled inward by the buffer, in the plane frame
      sx <- shapes_df$size_x[i] - 2 * inset
      sy <- shapes_df$size_y[i] - 2 * inset
      if (sx > 0 && sy > 0) {
        c_rot <- rotated_rect_corners(shapes_df$sq_center[[i]], sx, sy, shapes_df$angle[i])
        c_orig <- cbind(c_rot, shapes_df$z_level[i]) %*% t(shapes_df$V[[i]])
        c_orig <- sweep(c_orig, 2, shapes_df$center3[[i]], "+")
        cp <- rbind(c_orig[, 1:2, drop = FALSE], c_orig[1, 1:2, drop = FALSE])
        lines(cp[, 1], cp[, 2], col = "red", lwd = 2, lty = 2)
      }
    }
  })
  
  # Only the LAZ download is offered (no CSV)
  output$download_ui <- renderUI({
    if (length(rv$laz_files) > 0) downloadButton("download_laz", "Download Clipped LAZ (.zip)")
  })
  
  output$download_laz <- downloadHandler(
    filename = function() paste0(rv$mls_name, "_quadrats.zip"),
    content = function(file) {
      req(length(rv$laz_files) > 0)
      f <- rv$laz_files
      if (requireNamespace("zip", quietly = TRUE)) {
        zip::zipr(file, basename(f), root = dirname(f[1]))
      } else {
        utils::zip(file, f, flags = "-j")
      }
    }
  )
}

shinyApp(ui = ui, server = server)
